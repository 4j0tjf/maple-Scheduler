# 스케줄러 전용 DB. 시세 사이트(maple_market)·사냥 기록(maple_hunt)과 같은 Postgres의 별도 데이터베이스다.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/maple_scheduler?schema=public"
# 기존 사냥 기록 DB(maple-hunt). 기존 기록 가져오기(화면의 '기존 사냥 기록 가져오기', npm run hunt:import)에서만 읽는다. 비워 두면 가져오기를 끈다.
HUNT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/maple_hunt?schema=public"
# 솔 에르다 조각 시세를 받아 올 시세 사이트 주소(이 PC 안).
MARKET_URL="http://127.0.0.1:3000"
# 넥슨 Open API 키는 여기에 넣지 않는다. 사이트에 로그인한 뒤 왼쪽 계정 메뉴의 '넥슨 API 키'에서 계정마다 등록한다(accounts.nexon_api_key).

# npm run keys:prepare 로 서버 PC에서 생성. 값을 출력하거나 Git에 올리지 말고 DB 백업과 별도 보관.
NEXON_KEY_ENCRYPTION_KEY=""
